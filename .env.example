# KnowledgePilot AI — Environment Configuration (.env.example)
# Copy this file to .env before running docker-compose or local services.
# NEVER commit real API keys or production secrets to version control.

ENVIRONMENT=development

# Database Configuration
# For Docker Compose PostgreSQL + pgvector:
DATABASE_URL=postgresql://kp_user:kp_local_dev_password@db:5432/knowledgepilot
# For zero-dependency local development / automated test suite:
SQLITE_PATH=./data/knowledgepilot_ai.db

# Authentication & Session Security
SECRET_KEY=replace-with-64-byte-cryptographically-random-hmac-secret
SESSION_TTL_SECONDS=86400

# AI Provider Abstraction ('gemini' or 'local')
AI_PROVIDER=local
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Retrieval & Ingestion Guardrails
MAX_UPLOAD_BYTES=15728640
DEFAULT_TOP_K=5
HYBRID_ALPHA=0.55
MIN_EVIDENCE_SCORE=0.18
RATE_LIMIT_PER_MINUTE=60

# Frontend Public Configuration (Never place secret keys in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
